# Copy to .env and fill in. Both values are safe to ship in the extension:
# the key only allows what your Row Level Security policies permit.
# Use the "publishable" key (sb_publishable_...) from Project Settings -> API Keys;
# the legacy "anon" JWT also works.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
