{
  "name": "ind-sponsor-check",
  "version": "0.2.0",
  "private": true,
  "description": "Shows whether a company on LinkedIn, Indeed or its own website is an IND recognised sponsor (Netherlands).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "python3 scripts/resize-icons.py",
    "snapshot": "node scripts/update-snapshot.ts",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amirjf/ind-sponsor-check.git"
  }
}
